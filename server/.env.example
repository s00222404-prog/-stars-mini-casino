# Telegram bot token from BotFather. Set as a secret in Render.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat ID of the moderator who has opened the bot and sent /start.
# A bot cannot start a private chat with a user from their username alone.
MODERATOR_CHAT_ID=

# Optional: restrict CORS to the exact deployed frontend origin.
# Example: https://your-mini-app.example
ALLOWED_ORIGIN=

# Render sets PORT automatically. Do not set a fixed port in production.
PORT=10000
